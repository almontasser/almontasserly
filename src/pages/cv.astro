---
import Icon from '../components/Icon.astro'
import { contributions, education, experience, featured, projects, site, toolbox } from '../data/site'
import Base from '../layouts/Base.astro'

const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '')
const work = [featured, ...projects]
---

<Base title="Résumé" description={`Résumé of ${site.name}, ${site.role} in ${site.location}.`}>
  <article class="container cv">
    <div class="actions no-print">
      <button class="btn btn-primary" type="button" data-print><Icon name="file" /> Save as PDF</button>
      <span class="muted">Opens your browser's print dialog. Choose "Save as PDF".</span>
    </div>

    <header class="cv-head">
      <h1>{site.name}</h1>
      <p class="role">{site.role} · {site.location}</p>
      <ul class="contact mono">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.url}>{host(site.url)}</a></li>
        <li><a href={site.links.github}>{host(site.links.github)}</a></li>
        <li><a href={site.links.linkedin}>{host(site.links.linkedin)}</a></li>
      </ul>
      <p class="intro">{site.description}</p>
    </header>

    <section>
      <h2 class="label">Experience</h2>
      {
        experience.map((r) => (
          <div class="entry">
            <p class="when mono">{r.period}</p>
            <div>
              <h3>{r.role}</h3>
              <p class="muted">{r.org}</p>
              <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2 class="label">Education</h2>
      {
        education.map((e) => (
          <div class="entry">
            <p class="when mono">{e.year}</p>
            <h3>{e.degree}</h3>
          </div>
        ))
      }
    </section>

    <section>
      <h2 class="label">Projects</h2>
      {
        work.map((p) => (
          <div class="entry">
            <p class="when mono">{p.year}</p>
            <div>
              <h3>
                {p.links[0] ? <a href={p.links[0].href}>{p.name}</a> : p.name}
                {p.org && <span class="muted"> · {p.org}</span>}
              </h3>
              <p class="muted">{p.tagline}. {p.stack.join(', ')}.</p>
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2 class="label">Open source</h2>
      <ul class="plain">
        {
          contributions.map((c) => (
            <li>
              <a href={c.href} class="mono">{c.repo}</a>: {c.title}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="label">Skills</h2>
      <dl class="skills">
        {
          toolbox.map((t) => (
            <div>
              <dt>{t.title}</dt>
              <dd class="muted">{t.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </article>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => print())
</script>

<style>
  .cv {
    max-width: calc(820px + 2 * var(--gutter));
    padding-block: clamp(40px, 7vw, 80px) 96px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-bottom: 48px;
    font-size: 0.9rem;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    letter-spacing: -0.045em;
  }

  .role {
    margin-top: 10px;
    font-size: 1.15rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--fg-muted);
  }

  .intro {
    margin-top: 20px;
    color: var(--fg-muted);
  }

  section {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .entry {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 20px;
    margin-top: 16px;
    break-inside: avoid;
  }

  .when {
    font-size: 0.8rem;
    color: var(--fg-subtle);
    padding-top: 3px;
  }

  h3 {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  h3 a:hover,
  .plain a:hover {
    color: var(--accent);
  }

  .entry ul {
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }

  .plain {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }

  .plain li + li {
    margin-top: 6px;
  }

  .plain a {
    font-size: 0.85em;
    color: var(--fg);
  }

  .skills {
    margin: 12px 0 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 20px;
    padding-block: 4px;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
  }

  @media (max-width: 560px) {
    .entry,
    .skills div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  @media print {
    .cv {
      max-width: none;
      padding: 0;
      font-size: 10pt;
    }

    h1 {
      font-size: 24pt;
    }

    section {
      margin-top: 16px;
      padding-top: 10px;
    }

    .entry {
      margin-top: 8px;
    }
  }
</style>
