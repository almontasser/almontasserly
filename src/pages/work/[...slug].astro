---
import { render } from 'astro:content'
import Icon from '../../components/Icon.astro'
import { projects } from '../../data/site'
import Base from '../../layouts/Base.astro'
import { formatDate, getCaseStudies } from '../../lib/posts'

export async function getStaticPaths() {
  return (await getCaseStudies()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, summary, date, project: name } = entry.data
const project = projects.find((p) => p.name === name)
---

<Base title={title} description={summary} type="article" published={date}>
  <article class="container study">
    <header class="head">
      <a href="/#work" class="back mono"><Icon name="arrow-left" size={14} /> Work</a>
      <p class="label">Case study · {formatDate(date)}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {
        project && (
          <dl class="meta">
            <div><dt class="label">Project</dt><dd>{project.org ? `${project.name}, ${project.org}` : project.name}</dd></div>
            <div><dt class="label">When</dt><dd>{project.year}</dd></div>
            <div><dt class="label">Stack</dt><dd>{project.stack.join(', ')}</dd></div>
          </dl>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .study {
    max-width: calc(720px + 2 * var(--gutter));
    padding-block: clamp(40px, 7vw, 88px) 96px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 40px;
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.3rem, 6vw, 3.8rem);
    letter-spacing: -0.045em;
  }

  .summary {
    margin-top: 20px;
    font-size: 1.2rem;
    color: var(--fg-muted);
  }

  .head {
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .meta {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
  }

  .meta div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    align-items: baseline;
  }

  .meta dd {
    margin: 0;
    color: var(--fg-muted);
  }
</style>
