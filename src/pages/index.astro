---
import { Image } from 'astro:assets'
import portrait from '../assets/portrait.jpeg'
import Heatmap from '../components/Heatmap.astro'
import Icon from '../components/Icon.astro'
import { experience, featured, milestones, projects, site, toolbox } from '../data/site'
import Base from '../layouts/Base.astro'
import { getGitHub } from '../lib/github'
import { formatDate, getPosts, readingTime } from '../lib/posts'

const gh = await getGitHub()
const posts = (await getPosts()).slice(0, 4)
const num = new Intl.NumberFormat('en-US')
// Only show star counts once they say something.
const stars = (repo?: string) => (repo && gh.stars[repo] >= 20 ? gh.stars[repo] : undefined)

const stats = [
  gh.total !== null && { value: num.format(gh.total), label: 'GitHub contributions in the last year' },
  { value: `${new Date().getFullYear() - site.githubSince} yrs`, label: `Shipping code in public, since ${site.githubSince}` },
  { value: '~1 s', label: 'For Tusk to index a 23,000-file Laravel app' },
  { value: '3 ms', label: 'Of work per keystroke in Tusk, even in a 4,800-line file' },
].filter(Boolean) as { value: string; label: string }[]

const stack = [
  'PHP', 'Laravel', 'Filament', 'TypeScript', 'Node.js', 'NestJS', 'Rust', 'Tauri',
  'PostgreSQL', 'MySQL', 'Docker', 'Linux', 'Terraform', 'eBPF', 'Go', 'Odin',
]
---

<Base>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero-copy">
      <p class="hero-status anim">
        {
          site.availability && (
            <span class="pill">
              <span class="dot" />
              {site.availability}
            </span>
          )
        }
        <span class="mono muted">{site.role} · {site.location}</span>
      </p>

      <h1 class="hero-name anim">
        <span class="line"><span>Mahmoud</span></span>
        <span class="line"><span>Almontasser</span></span>
      </h1>

      <p class="hero-lead anim">
        I build <em class="serif">dependable</em> backends in Laravel and Node.js, run the Linux
        servers under them, and write developer tools in Rust, from a PHP language server to a
        compiler.
      </p>

      <div class="hero-cta anim">
        <a class="btn btn-primary" href="#work">See my work <Icon name="arrow-down" /></a>
        <button class="btn copy" data-copy={site.email} aria-label={`Copy ${site.email}`}>
          <Icon name="copy" class="i-copy" />
          <Icon name="check" class="i-check" />
          <span class="copy-idle">{site.email}</span>
          <span class="copy-done">Copied</span>
        </button>
      </div>

      <ul class="socials anim">
        <li><a href={site.links.github} aria-label="GitHub"><Icon name="github" size={20} /></a></li>
        <li><a href={site.links.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={19} /></a></li>
        <li><a href={site.links.x} aria-label="X"><Icon name="x" size={17} /></a></li>
        <li><a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={20} /></a></li>
      </ul>
    </div>

    <figure class="portrait anim">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Mahmoud Almontasser outdoors in a white shirt and dark waistcoat"
          widths={[380, 560, 760]}
          sizes="(max-width: 900px) 78vw, 400px"
          loading="eager"
          fetchpriority="high"
        />
        <i class="cm tl"></i><i class="cm tr"></i><i class="cm bl"></i><i class="cm br"></i>
      </div>
      <figcaption class="mono">
        <span>Fig. 01 · Misurata, LY</span>
        <span><span data-clock>--:--</span> local</span>
      </figcaption>
      <a class="now card" href={featured.links[0].href}>
        <span class="label">Now building</span>
        <span class="now-title">{featured.name} <Icon name="arrow-up-right" size={15} /></span>
        <span class="muted">{featured.tagline}</span>
      </a>
    </figure>
  </section>

  <!-- Stack ticker -->
  <div class="ticker anim" aria-label="Technologies I work with">
    <ul>
      {[...stack, ...stack].map((s, i) => <li aria-hidden={i >= stack.length ? 'true' : undefined}>{s}</li>)}
    </ul>
  </div>

  <!-- Stats -->
  <section class="container stats" aria-label="At a glance">
    {
      stats.map((s) => (
        <div class="stat reveal">
          <p class="stat-value">{s.value}</p>
          <p class="stat-label">{s.label}</p>
        </div>
      ))
    }
  </section>

  <!-- Work -->
  <section id="work" class="section container">
    <header class="section-head reveal">
      <p class="label">01 / Selected work</p>
      <h2>Tools I build, <em class="serif">and systems I run</em></h2>
      <p>
        Products and tools I build in my own time, from a PHP editor and a print-on-demand shop to a
        compiler, and Ersaal, the SMS gateway for businesses in Libya whose backend I lead at Lamah.
      </p>
    </header>

    <article class="featured card reveal">
      <div class="featured-copy">
        <p class="label">
          <span>Featured</span> · <span>{featured.year}</span>
          {stars(featured.repo) !== undefined && <span> · ★ {stars(featured.repo)}</span>}
        </p>
        <h3>{featured.name}</h3>
        <p class="tagline">{featured.tagline}</p>
        <p class="muted">{featured.description}</p>
        <dl class="highlights">
          {
            featured.highlights?.map((h) => (
              <div>
                <dt>{h.value}</dt>
                <dd>{h.label}</dd>
              </div>
            ))
          }
        </dl>
        <ul class="chips">{featured.stack.map((s) => <li class="chip">{s}</li>)}</ul>
        <div class="card-links">
          {
            featured.links.map((l, i) => (
              <a class={i === 0 ? 'btn btn-primary' : 'btn'} href={l.href}>
                {l.label} <Icon name="arrow-up-right" />
              </a>
            ))
          }
        </div>
      </div>
      {
        featured.image && (
          <div class="featured-shot">
            <Image
              src={featured.image}
              alt={featured.imageAlt ?? ''}
              widths={[640, 960, 1400]}
              sizes="(max-width: 900px) 92vw, 620px"
            />
          </div>
        )
      }
    </article>

    <div class="projects">
      {
        projects.map((p, i) => (
          <article class:list={['project card reveal', { wide: p.wide, shot: p.image }]}>
            <div class="project-body">
            <p class="label project-meta">
              <span>{String(i + 2).padStart(2, '0')}</span>
              <span>
                {p.org && `${p.org} · `}
                {p.year}
                {stars(p.repo) ? ` · ★ ${stars(p.repo)}` : ''}
              </span>
            </p>
            <h3>{p.name}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="muted">{p.description}</p>
            <ul class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>
            {p.links.length > 0 && (
              <div class="project-links">
                {p.links.map((l) => (
                  <a class="link" href={l.href}>
                    {l.label} <Icon name="arrow-up-right" size={14} />
                  </a>
                ))}
              </div>
            )}
            </div>
            {p.image && (
              <div class="featured-shot">
                <Image
                  src={p.image}
                  alt={p.imageAlt ?? ''}
                  widths={[640, 960, 1400]}
                  sizes="(max-width: 900px) 92vw, 600px"
                />
              </div>
            )}
          </article>
        ))
      }
    </div>

    <p class="more reveal">
      <a class="link" href={site.links.github}>More on GitHub <Icon name="arrow-up-right" size={14} /></a>
    </p>
  </section>

  <!-- Experience -->
  <section id="experience" class="section container">
    <header class="section-head reveal">
      <p class="label">02 / Experience</p>
      <h2>From Delphi to <em class="serif">leading a backend team</em></h2>
      <p>
        I wrote my first program at 12 and have shipped software ever since. Desktop apps first,
        then the web, then the servers and networks underneath it.
      </p>
    </header>

    <div class="xp">
      <ol class="roles">
        {
          experience.map((r) => (
            <li class="role reveal">
              <p class="label">{r.period}</p>
              <div>
                <h3>{r.role}</h3>
                <p class="muted">{r.org}</p>
                <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="milestones reveal" aria-label="Milestones">
        <p class="label">Milestones</p>
        <ol>
          {
            milestones.map((m) => (
              <li>
                <span class="mono">{m.year}</span>
                <p>{m.text}</p>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </section>

  <!-- Toolbox -->
  <section id="toolbox" class="section container">
    <header class="section-head reveal">
      <p class="label">03 / Toolbox</p>
      <h2>The whole stack, <em class="serif">down to the metal</em></h2>
      <p>I'm happiest where the backend meets the infrastructure, and I'll go lower when a problem needs it.</p>
    </header>

    <div class="tools reveal">
      {
        toolbox.map((t) => (
          <div class="tool">
            <h3>{t.title}</h3>
            <p class="muted">{t.note}</p>
            <ul class="chips">{t.items.map((s) => <li class="chip">{s}</li>)}</ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Activity -->
  {
    gh.days.length > 0 && (
      <section id="activity" class="section container">
        <header class="section-head reveal">
          <p class="label">04 / Activity</p>
          <h2>
            {gh.total !== null ? num.format(gh.total) : 'Plenty of'} contributions <em class="serif">in the last year</em>
          </h2>
          <p>Most of my work happens in private repositories, so this graph is the best public view of my pace.</p>
        </header>
        <div class="activity card reveal">
          <Heatmap days={gh.days} />
          <div class="activity-foot mono">
            <a class="link" href={site.links.github}>
              @{site.githubUser} on GitHub <Icon name="arrow-up-right" size={13} />
            </a>
            <span class="legend" aria-hidden="true">
              Less <i data-l="0" /><i data-l="1" /><i data-l="2" /><i data-l="3" /><i data-l="4" /> More
            </span>
          </div>
        </div>
      </section>
    )
  }

  <!-- Writing -->
  {
    posts.length > 0 && (
      <section id="writing" class="section container">
        <header class="section-head reveal">
          <p class="label">05 / Writing</p>
          <h2>Notes from <em class="serif">the terminal</em></h2>
          <p>Short write-ups of problems I solved, so you don't have to solve them again.</p>
        </header>
        <ul class="posts">
          {posts.map((p) => (
            <li class="reveal">
              <a href={`/blog/${p.id}`}>
                <time class="mono" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                <span class="post-title">{p.data.title}</span>
                <span class="mono muted post-read">{readingTime(p.body)}</span>
                <Icon name="arrow-right" class="post-arrow" />
              </a>
            </li>
          ))}
        </ul>
        <p class="more reveal">
          <a class="link" href="/blog">All writing <Icon name="arrow-right" size={14} /></a>
        </p>
      </section>
    )
  }

  <!-- Contact -->
  <section id="contact" class="section container contact">
    <div class="contact-glow" aria-hidden="true"></div>
    <p class="label reveal">06 / Contact</p>
    <h2 class="reveal">
      Need someone to own <br class="br" />your <em class="serif">backend?</em>
    </h2>
    <p class="muted reveal">
      I'm open to backend engineering and team-lead roles. Tell me about the problem, the team, and
      the stack.
    </p>
    <div class="contact-cta reveal">
      <a class="btn btn-primary" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
      <a class="btn" href={site.links.linkedin}><Icon name="linkedin" size={16} /> LinkedIn</a>
      <a class="btn" href={site.links.github}><Icon name="github" size={16} /> GitHub</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
    padding-block: clamp(48px, 9vw, 112px) clamp(56px, 8vw, 96px);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -68px 0 0;
    z-index: -1;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 40%, #000 20%, transparent 75%);
  }

  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 28px;
    font-size: 0.8rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 30px;
    padding-inline: 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-elev);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .hero-copy {
    container-type: inline-size;
  }

  .hero-name {
    font-size: clamp(2.6rem, 16.5cqi, 7.6rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .line > span {
    display: inline-block;
  }

  .line + .line > span {
    background: linear-gradient(100deg, var(--fg) 30%, var(--fg-subtle));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 34rem;
    margin-top: 28px;
    font-size: clamp(1.08rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .hero-lead .serif {
    font-size: 1.15em;
    color: var(--fg);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .copy :global(.i-check),
  .copy .copy-done,
  .copy[data-copied] :global(.i-copy),
  .copy[data-copied] .copy-idle {
    display: none;
  }

  .copy[data-copied] :global(.i-check),
  .copy[data-copied] .copy-done {
    display: inline;
    color: var(--ok);
  }

  .socials {
    display: flex;
    gap: 6px;
    margin: 28px 0 0 -10px;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--fg-subtle);
    transition:
      color 0.2s,
      background 0.2s;
  }

  .socials a:hover {
    color: var(--fg);
    background: var(--surface);
  }

  /* Portrait */
  .portrait {
    position: relative;
    margin: 0;
    max-width: 420px;
    justify-self: end;
    width: 100%;
  }

  .portrait-frame {
    position: relative;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: var(--bg-elev);
  }

  .portrait-frame::before {
    content: '';
    position: absolute;
    inset: 15% -10% -5%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(34 211 238 / 0.22), transparent);
    filter: blur(40px);
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius);
  }

  .cm {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }

  .tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 8px; }
  .tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; border-top-right-radius: 8px; }
  .bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; border-bottom-left-radius: 8px; }
  .br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; border-bottom-right-radius: 8px; }

  figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
    padding-inline: 4px;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .now {
    position: absolute;
    left: -56px;
    bottom: 56px;
    display: grid;
    gap: 4px;
    max-width: 250px;
    padding: 14px 16px;
    border-color: var(--line-strong);
    background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.5);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .now-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .now:hover .now-title {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .anim {
      animation: fade-up 0.9s var(--ease) both;
    }

    .hero-name.anim {
      animation: none;
    }

    .hero-name .line > span {
      animation: rise 1s var(--ease) both;
    }

    .hero-name .line + .line > span {
      animation-delay: 0.08s;
    }

    .hero-lead { animation-delay: 0.2s; }
    .hero-cta { animation-delay: 0.3s; }
    .socials { animation-delay: 0.38s; }
    .portrait { animation-delay: 0.15s; }
    .now { animation: fade-up 0.9s 0.6s var(--ease) both; }
  }

  @keyframes rise {
    from { transform: translateY(105%); }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .portrait {
      justify-self: start;
      max-width: 380px;
    }

    .now {
      left: auto;
      right: 12px;
      bottom: 64px;
    }
  }

  /* Ticker */
  .ticker {
    border-block: 1px solid var(--line);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .ticker ul {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 18px 0;
    list-style: none;
    font: 400 0.9rem/1 var(--font-mono);
    color: var(--fg-muted);
  }

  .ticker li::after {
    content: '/';
    padding-inline: 22px;
    color: var(--fg-subtle);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker ul {
      animation: marquee 45s linear infinite;
    }

    .ticker:hover ul {
      animation-play-state: paused;
    }
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-block: 0;
  }

  .stat {
    padding: 40px 28px 40px 0;
  }

  .stat + .stat {
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .stat-label {
    margin-top: 12px;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--fg-muted);
  }

  @media (max-width: 860px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }

    .stat:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* Work */
  h3 {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }

  .tagline {
    margin-top: 6px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--fg);
  }

  .tagline + .muted {
    margin-top: 14px;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 40px;
    padding: clamp(24px, 4vw, 48px) 0 0 clamp(24px, 4vw, 48px);
  }

  .featured-copy {
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  .featured h3 {
    margin-top: 18px;
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    letter-spacing: -0.05em;
  }

  .featured .tagline {
    font-size: 1.5rem;
  }

  .highlights {
    display: grid;
    gap: 14px;
    margin: 28px 0;
    padding: 20px 0;
    border-block: 1px solid var(--line);
  }

  .highlights div {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    align-items: baseline;
  }

  .highlights dt {
    font: 600 1.15rem/1 var(--font-mono);
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .highlights dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .featured-shot {
    align-self: end;
    position: relative;
  }

  .featured-shot img {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-right: 0;
    border-bottom: 0;
    border-top-left-radius: 12px;
    box-shadow: -30px -20px 80px -40px rgb(34 211 238 / 0.35);
    transition: transform 0.6s var(--ease);
    transform-origin: bottom right;
  }

  .featured:hover .featured-shot img,
  .project:hover .featured-shot img {
    transform: scale(1.02) translate(-4px, -4px);
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
