---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import portrait from '../../assets/portrait.jpeg'
import Icon from '../../components/Icon.astro'
import { site } from '../../data/site'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts, readingTime } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }))
}

const { post, newer, older } = Astro.props
const { Content } = await render(post)
const { title, summary, date, updated, tags } = post.data
---

<Base title={title} description={summary} type="article" published={date}>
  <div class="progress" aria-hidden="true"></div>

  <article class="container post">
    <header class="post-head">
      <a href="/blog" class="back mono"><Icon name="arrow-left" size={14} /> Writing</a>
      <p class="label">
        <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)}
        {updated && <> · Updated {formatDate(updated)}</>}
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {tags.length > 0 && <ul class="chips">{tags.map((t) => <li class="chip">#{t}</li>)}</ul>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <div class="author card">
        <Image src={portrait} alt="" width={112} height={112} class="avatar" />
        <div>
          <p><strong>{site.name}</strong></p>
          <p class="muted">
            {site.role} in {site.location}. Questions or a correction?{' '}
            <a class="link" href={`mailto:${site.email}?subject=${encodeURIComponent(title)}`}>Email me</a>.
          </p>
        </div>
      </div>

      <nav class="pager" aria-label="More posts">
        {
          older ? (
            <a href={`/blog/${older.id}`} class="card">
              <span class="label">Older</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a href={`/blog/${newer.id}`} class="card next">
              <span class="label">Newer</span>
              {newer.data.title}
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>

<script>
  // Copy buttons on code blocks.
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button')
    btn.className = 'copy-code mono'
    btn.type = 'button'
    btn.textContent = 'Copy'
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '')
        btn.textContent = 'Copied'
      } catch {
        btn.textContent = 'Failed'
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600)
    })
    const wrap = document.createElement('div')
    wrap.className = 'code-wrap'
    pre.replaceWith(wrap)
    wrap.append(pre, btn)
  })
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: 0 50%;
    transform: scaleX(0);
    animation: progress linear both;
    animation-timeline: scroll(root);
  }

  @supports not (animation-timeline: scroll()) {
    .progress {
      display: none;
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .post {
    max-width: calc(720px + 2 * var(--gutter));
    padding-block: clamp(40px, 7vw, 88px) 96px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 40px;
    font-size: 0.8rem;
    color: var(--fg-subtle);
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--accent);
  }

  .post-head h1 {
    margin-top: 16px;
    font-size: clamp(2.3rem, 6vw, 3.8rem);
    letter-spacing: -0.045em;
  }

  .summary {
    margin-top: 20px;
    font-size: 1.2rem;
    color: var(--fg-muted);
  }

  .post-head .chips {
    margin-top: 24px;
  }

  .post-head {
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .post-foot {
    margin-top: 72px;
    display: grid;
    gap: 16px;
  }

  .author {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 22px;
  }

  .author :global(.avatar) {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .author p + p {
    margin-top: 2px;
    font-size: 0.95rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .pager a {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    font-weight: 500;
  }

  .pager .next {
    text-align: right;
  }

  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .prose {
    font-size: 1.075rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--fg) 88%, var(--fg-muted));
  }

  .prose > * + * {
    margin-top: 1.25em;
  }

  .prose h2,
  .prose h3 {
    margin-top: 2.2em;
    color: var(--fg);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .prose h2 {
    font-size: 1.7rem;
  }

  .prose h3 {
    font-size: 1.3rem;
  }

  .prose h2 + *,
  .prose h3 + * {
    margin-top: 0.75em;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .prose strong {
    color: var(--fg);
    font-weight: 600;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: 0.4em;
  }

  .prose li::marker {
    color: var(--fg-subtle);
  }

  .prose :not(pre) > code {
    padding: 0.15em 0.4em;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    font: 0.86em var(--font-mono);
    color: var(--fg);
  }

  .prose blockquote {
    margin-inline: 0;
    padding-left: 1.2em;
    border-left: 2px solid var(--accent);
    color: var(--fg-muted);
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose img {
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .code-wrap {
    position: relative;
  }

  .prose pre {
    margin: 0;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow-x: auto;
    font: 0.86rem/1.7 var(--font-mono);
    tab-size: 4;
  }

  .copy-code {
    position: absolute;
    top: 10px;
    right: 10px;
    height: 28px;
    padding-inline: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-elev);
    font-size: 0.72rem;
    color: var(--fg-muted);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .code-wrap:hover .copy-code,
  .copy-code:focus-visible {
    opacity: 1;
  }

  @media (hover: none) {
    .copy-code {
      opacity: 1;
    }
  }
</style>
