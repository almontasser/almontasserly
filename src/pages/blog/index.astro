---
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts, readingTime } from '../../lib/posts'

const posts = await getPosts()
---

<Base title="Writing" description="Notes on Laravel, Linux, and the tools I use every day.">
  <section class="container page">
    <header class="section-head">
      <p class="label">Writing</p>
      <h1>Notes from <em class="serif">the terminal</em></h1>
      <p>Short write-ups of problems I solved, so you don't have to solve them again.</p>
      <p>
        <a class="link mono rss" href="/rss.xml"><Icon name="rss" size={14} /> Subscribe with RSS</a>
      </p>
    </header>

    <ol class="list">
      {
        posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="item">
              <p class="label">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time> ·{' '}
                {readingTime(p.body)}
              </p>
              <h2>{p.data.title}</h2>
              <p class="muted">{p.data.summary}</p>
              <ul class="chips">
                {p.data.tags.map((t) => (
                  <li class="chip">#{t}</li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .page {
    padding-block: clamp(48px, 8vw, 96px) 120px;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    letter-spacing: -0.05em;
  }

  .rss {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .item {
    display: grid;
    gap: 10px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.25s var(--ease);
  }

  .item:hover {
    padding-left: 16px;
  }

  .item h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.035em;
    transition: color 0.2s;
  }

  .item:hover h2 {
    color: var(--accent);
  }

  .item .muted {
    max-width: 65ch;
  }

  .item .chips {
    margin-top: 6px;
  }
</style>
