---
import { featured, site } from '../data/site'
import { getCaseStudies, getPosts } from '../lib/posts'
import Icon from './Icon.astro'

const posts = await getPosts()
const studies = await getCaseStudies()

const groups = [
  {
    name: 'Pages',
    items: [
      { label: 'Home', href: '/', icon: 'home' },
      { label: 'Selected work', href: '/#work', icon: 'hash' },
      { label: 'Experience', href: '/#experience', icon: 'hash' },
      { label: 'Writing', href: '/blog', icon: 'file' },
      { label: 'About', href: '/about', icon: 'user' },
      { label: 'Now', href: '/now', icon: 'hash' },
      { label: 'Uses', href: '/uses', icon: 'hash' },
      { label: 'Résumé (CV)', href: '/cv', icon: 'file' },
      { label: 'Contact', href: '/#contact', icon: 'mail' },
    ],
  },
  {
    name: 'Writing',
    items: posts.map((p) => ({ label: p.data.title, href: `/blog/${p.id}`, icon: 'file' })),
  },
  {
    name: 'Case studies',
    items: studies.map((s) => ({ label: s.data.title, href: `/work/${s.id}`, icon: 'file' })),
  },
  {
    name: 'Actions',
    items: [
      { label: 'Copy email address', action: 'copy-email', icon: 'copy' },
      { label: 'Switch light or dark theme', action: 'theme', icon: 'sun' },
    ],
  },
  {
    name: 'Elsewhere',
    items: [
      { label: `${featured.name} website`, href: featured.links[0].href, icon: 'arrow-up-right' },
      { label: 'GitHub', href: site.links.github, icon: 'github' },
      { label: 'LinkedIn', href: site.links.linkedin, icon: 'linkedin' },
      { label: 'X', href: site.links.x, icon: 'x' },
      { label: 'RSS feed', href: '/rss.xml', icon: 'rss' },
    ],
  },
].filter((g) => g.items.length > 0) as { name: string; items: { label: string; href?: string; action?: string; icon: string }[] }[]
---

<dialog id="cmdk" class="cmdk" aria-label="Command menu">
  <form method="dialog" class="cmdk-box">
    <label class="cmdk-search">
      <Icon name="search" size={18} />
      <span class="sr-only">Search pages, posts, and actions</span>
      <input
        type="text"
        placeholder="Jump to a page, post, or action…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
      />
      <kbd>esc</kbd>
    </label>
    <div id="cmdk-list" class="cmdk-list" role="listbox">
      {
        groups.map((g) => (
          <section data-group>
            <p class="label">{g.name}</p>
            {g.items.map((item) =>
              item.href ? (
                <a
                  role="option"
                  href={item.href}
                  data-item
                  {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <Icon name={item.icon} size={16} />
                  {item.label}
                </a>
              ) : (
                <button type="button" role="option" data-item data-action={item.action}>
                  <Icon name={item.icon} size={16} />
                  {item.label}
                </button>
              ),
            )}
          </section>
        ))
      }
      <p class="cmdk-empty muted" hidden>No results.</p>
    </div>
    <footer class="cmdk-foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span class="cmdk-status" aria-live="polite"></span>
    </footer>
  </form>
</dialog>

<script>
  const dialog = document.getElementById('cmdk') as HTMLDialogElement
  const input = dialog.querySelector('input')!
  const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')]
  const groups = [...dialog.querySelectorAll<HTMLElement>('[data-group]')]
  const empty = dialog.querySelector<HTMLElement>('.cmdk-empty')!
  const status = dialog.querySelector<HTMLElement>('.cmdk-status')!
  let active = 0

  const visible = () => items.filter((el) => !el.hidden)

  function highlight(i: number) {
    const list = visible()
    if (!list.length) return
    active = (i + list.length) % list.length
    list.forEach((el, n) => el.toggleAttribute('data-active', n === active))
    list[active].scrollIntoView({ block: 'nearest' })
  }

  function filter() {
    const q = input.value.trim().toLowerCase()
    items.forEach((el) => (el.hidden = !el.textContent!.toLowerCase().includes(q)))
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-item]:not([hidden])')))
    empty.hidden = visible().length > 0
    highlight(0)
  }

  function open() {
    if (dialog.open) return
    input.value = ''
    status.textContent = ''
    filter()
    dialog.showModal()
  }

  document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open))

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault()
      dialog.open ? dialog.close() : open()
    }
  })

  input.addEventListener('input', filter)
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault()
      highlight(active + (e.key === 'ArrowDown' ? 1 : -1))
    } else if (e.key === 'Enter') {
      e.preventDefault()
      visible()[active]?.click()
    }
  })

  items.forEach((el) => {
    el.addEventListener('mousemove', () => highlight(visible().indexOf(el)))
    el.addEventListener('click', () => {
      const action = el.dataset.action
      if (action === 'copy-email') {
        document.querySelector<HTMLButtonElement>('[data-copy]')?.click()
        status.textContent = 'Email copied'
        return
      }
      if (action === 'theme') {
        document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click()
        return
      }
      dialog.close()
    })
  })

  // Close when the backdrop is clicked.
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close())
</script>

<style>
  .cmdk {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--bg-elev);
    color: var(--fg);
    box-shadow:
      0 30px 80px -20px rgb(0 0 0 / 0.6),
      0 0 0 1px rgb(255 255 255 / 0.02) inset;
    overflow: hidden;
  }

  .cmdk[open] {
    animation: pop 0.18s var(--ease);
  }

  .cmdk::backdrop {
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(6px);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .cmdk-box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .cmdk-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    height: 60px;
    border-bottom: 1px solid var(--line);
    color: var(--fg-subtle);
  }

  .cmdk-search input {
    flex: 1;
    height: 100%;
    background: none;
    border: 0;
    outline: 0;
    color: var(--fg);
    font: inherit;
    font-size: 1.02rem;
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding-inline: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font: 500 0.7rem/1 var(--font-mono);
    color: var(--fg-muted);
  }

  .cmdk-list {
    overflow-y: auto;
    padding: 8px;
    overscroll-behavior: contain;
  }

  .cmdk-list section + section {
    margin-top: 6px;
  }

  .cmdk-list .label {
    padding: 10px 12px 6px;
  }

  [data-item] {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--fg-muted);
    text-align: left;
    font-size: 0.95rem;
  }

  [data-item][data-active] {
    background: var(--surface);
    color: var(--fg);
  }

  [data-item][data-active] :global(svg) {
    color: var(--accent);
  }

  .cmdk-empty {
    padding: 24px 12px;
    text-align: center;
  }

  .cmdk-foot {
    display: flex;
    gap: 18px;
    padding: 10px 18px;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--fg-subtle);
  }

  .cmdk-foot kbd {
    min-width: 18px;
    height: 18px;
    margin-right: 4px;
  }

  .cmdk-status {
    margin-left: auto;
    color: var(--accent);
  }
</style>
