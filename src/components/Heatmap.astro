---
import type { Day } from '../lib/github'

interface Props {
  days: Day[]
}

const { days } = Astro.props
const date = (s: string) => new Date(`${s}T00:00:00Z`)
const month = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' })
const full = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})

// Pad the first week so columns start on Sunday, like GitHub's graph.
const cells: (Day | null)[] = [...Array(days.length ? date(days[0].date).getUTCDay() : 0).fill(null), ...days]
const weeks = Array.from({ length: Math.ceil(cells.length / 7) }, (_, i) => cells.slice(i * 7, i * 7 + 7))

const months: { col: number; label: string }[] = []
weeks.forEach((week, col) => {
  const first = week.find(Boolean)
  if (!first) return
  const m = date(first.date).getUTCMonth()
  const prev = col > 0 ? weeks[col - 1].find(Boolean) : null
  if (!prev || date(prev.date).getUTCMonth() !== m) months.push({ col, label: month.format(date(first.date)) })
})
// Drop a leading label that would collide with the next one.
if (months.length > 1 && months[1].col - months[0].col < 3) months.shift()

const tip = (d: Day) =>
  `${d.count === 0 ? 'No' : d.count} contribution${d.count === 1 ? '' : 's'} on ${full.format(date(d.date))}`
---

<div class="heat-scroll" data-heat>
  <div class="heat" style={`--weeks:${weeks.length}`}>
    <div class="months" aria-hidden="true">
      {months.map((m) => <span style={`grid-column:${m.col + 1}`}>{m.label}</span>)}
    </div>
    <div class="days" aria-hidden="true">
      <span style="grid-row:2">Mon</span>
      <span style="grid-row:4">Wed</span>
      <span style="grid-row:6">Fri</span>
    </div>
    <div class="grid" role="img" aria-label="GitHub contributions over the last year">
      {cells.map((d) => (d ? <i data-l={d.level} title={tip(d)} /> : <i class="pad" />))}
    </div>
  </div>
</div>

<script>
  // Show the most recent weeks first on narrow screens.
  document.querySelectorAll<HTMLElement>('[data-heat]').forEach((el) => (el.scrollLeft = el.scrollWidth))
</script>

<style>
  .heat-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 6px;
  }

  .heat {
    --cell: clamp(10px, 1.45vw, 15px);
    --gap: 3px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 8px 10px;
    width: max-content;
    font: 400 0.68rem/1 var(--font-mono);
    color: var(--fg-subtle);
  }

  .months {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(var(--weeks), var(--cell));
    gap: var(--gap);
  }

  .months span {
    white-space: nowrap;
  }

  .days {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    gap: var(--gap);
    align-items: center;
  }

  .grid {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    grid-auto-columns: var(--cell);
    grid-auto-flow: column;
    gap: var(--gap);
  }

  i {
    border-radius: 3px;
    background: var(--heat-0);
    transition: transform 0.15s var(--ease);
  }

  i:not(.pad):hover {
    transform: scale(1.35);
    outline: 1px solid var(--fg-muted);
  }

  .pad {
    background: none;
  }

  [data-l='1'] {
    background: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  [data-l='2'] {
    background: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  [data-l='3'] {
    background: color-mix(in srgb, var(--accent) 75%, transparent);
  }

  [data-l='4'] {
    background: var(--accent);
  }
</style>
