---
import '../styles/global.css'
import { Font } from 'astro:assets'
import CommandPalette from '../components/CommandPalette.astro'
import Icon from '../components/Icon.astro'
import { site } from '../data/site'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
  published?: Date
  updated?: Date
  image?: string // path to a 1200×630 preview; defaults to /og.png
}

const {
  title,
  description = site.description,
  type = 'website',
  published,
  updated,
  image = '/og.png',
} = Astro.props
const fullTitle = title ? `${title} · ${site.name}` : site.title
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
const path = Astro.url.pathname

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Writing', href: '/blog' },
  { label: 'About', href: '/about' },
]

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Misurata', addressCountry: 'LY' },
  sameAs: Object.values(site.links),
}

const article = published && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical,
  image: ogImage,
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/rss.xml" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@Montasser93" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-serif" />

    <script is:inline>
      try {
        const saved = localStorage.getItem('theme')
        document.documentElement.dataset.theme =
          saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(article || person)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label={`${site.name}, home`}>
          <span class="mono">almontasser</span>
        </a>

        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      item.href !== '/' && path.startsWith(item.href) ? 'page' : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="nav-actions">
          <button class="icon-btn cmdk-btn" data-cmdk-open aria-label="Open command menu">
            <Icon name="search" size={16} />
            <span class="mono kbd-hint" aria-hidden="true">⌘K</span>
            <span class="menu-hint" aria-hidden="true">Menu</span>
          </button>
          <button class="icon-btn" data-theme-toggle aria-label="Switch light or dark theme">
            <Icon name="sun" size={17} class="sun" />
            <Icon name="moon" size={17} class="moon" />
          </button>
          <a href="/#contact" class="btn btn-primary nav-cta">Contact</a>
        </div>
      </div>
    </header>

    <div class="frame">
      <main id="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="container">
          <div class="footer-top">
            <div class="footer-id">
              <p>
                <strong>{site.name}</strong><br />
                <span class="muted">{site.role} · {site.location}</span>
              </p>
            </div>
            <div class="footer-cols">
              <div>
                <p class="label">Site</p>
                <ul>
                  {nav.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
                  <li><a class="link" href="/now">Now</a></li>
                  <li><a class="link" href="/uses">Uses</a></li>
                  <li><a class="link" href="/cv">Résumé</a></li>
                </ul>
              </div>
              <div>
                <p class="label">Elsewhere</p>
                <ul>
                  <li><a class="link" href={site.links.github}>GitHub</a></li>
                  <li><a class="link" href={site.links.linkedin}>LinkedIn</a></li>
                  <li><a class="link" href={site.links.x}>X</a></li>
                  <li><a class="link" href="/rss.xml">RSS</a></li>
                </ul>
              </div>
            </div>
          </div>
          <p class="wordmark" aria-hidden="true">almontasser</p>
          <div class="footer-bottom mono">
            <span>© {new Date().getFullYear()} {site.name}</span>
            <span>
              Built with <a class="link" href="https://astro.build">Astro</a> and hand-written CSS ·{' '}
              <a class="link" href="https://github.com/almontasser/almontasserly">Source</a>
            </span>
            <span><span data-clock>--:--</span> in Misurata</span>
          </div>
        </div>
      </footer>
    </div>

    <CommandPalette />

    <script>
      import { site } from '../data/site'

      // Live local time.
      const fmt = new Intl.DateTimeFormat('en-GB', {
        timeZone: site.timeZone,
        hour: '2-digit',
        minute: '2-digit',
        numberingSystem: 'latn',
      })
      const hourFmt = new Intl.DateTimeFormat('en-GB', { timeZone: site.timeZone, hour: 'numeric', hourCycle: 'h23' })
      // ponytail: rough guess from the clock alone; ignores holidays and weekends.
      const status = (h: number) => (h < 8 ? 'probably asleep' : h < 17 ? 'at work' : 'evening, may reply')
      const tick = () => {
        document.querySelectorAll('[data-clock]').forEach((el) => (el.textContent = fmt.format()))
        const s = status(Number(hourFmt.format()))
        document.querySelectorAll('[data-status]').forEach((el) => (el.textContent = s))
      }
      tick()
      setInterval(tick, 15_000)

      // Theme toggle, with a circular reveal where supported.
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const root = document.documentElement
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
          const apply = () => {
            root.dataset.theme = next
            try {
              localStorage.setItem('theme', next)
            } catch {}
          }
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
          if (!document.startViewTransition || reduce) return apply()
          const r = btn.getBoundingClientRect()
          const x = r.left + r.width / 2
          const y = r.top + r.height / 2
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
          document.startViewTransition(apply).ready.then(() =>
            root.animate(
              { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
              { duration: 500, easing: 'cubic-bezier(.2,.7,.2,1)', pseudoElement: '::view-transition-new(root)' },
            ),
          )
        }),
      )

      // Copy-to-clipboard buttons.
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy!)
            btn.dataset.copied = ''
            setTimeout(() => delete btn.dataset.copied, 1800)
          } catch {
            location.href = `mailto:${btn.dataset.copy}`
          }
        }),
      )

      // Spotlight that follows the cursor across cards.
      document.addEventListener('pointermove', (e) => {
        const card = (e.target as Element).closest?.<HTMLElement>('.card')
        if (!card) return
        const r = card.getBoundingClientRect()
        card.style.setProperty('--mx', `${e.clientX - r.left}px`)
        card.style.setProperty('--my', `${e.clientY - r.top}px`)
      })
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    animation: nav-solid linear both;
    animation-timeline: scroll();
    animation-range: 0 80px;
  }

  @keyframes nav-solid {
    to {
      background: color-mix(in srgb, var(--bg) 78%, transparent);
      backdrop-filter: blur(14px) saturate(1.4);
    }
  }

  @supports not (animation-timeline: scroll()) {
    .nav {
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(14px);
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--fg-muted);
    font-size: 0.92rem;
    transition:
      color 0.2s,
      background 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
    background: var(--surface);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    min-width: 38px;
    padding-inline: 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg-muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .kbd-hint {
    font-size: 0.72rem;
  }

  .menu-hint {
    display: none;
    font-size: 0.85rem;
  }

  [data-theme='dark'] .sun,
  [data-theme='light'] .moon {
    display: none;
  }

  .nav-cta {
    height: 38px;
    padding-inline: 16px;
    font-size: 0.88rem;
  }

  @media (max-width: 760px) {
    nav,
    .nav-cta {
      display: none;
    }

    .nav-actions {
      margin-left: auto;
    }

    .kbd-hint {
      display: none;
    }

    .menu-hint {
      display: inline;
    }
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--line);
    padding-top: 64px;
    overflow: hidden;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-id {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    line-height: 1.5;
  }

  .footer-cols {
    display: flex;
    gap: clamp(40px, 8vw, 96px);
  }

  .footer-cols ul {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    color: var(--fg-muted);
  }

  .wordmark {
    margin: 56px 0 0;
    font-size: clamp(3.4rem, 15.5vw, 12.5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    background: linear-gradient(180deg, var(--surface), transparent 85%);
    background-clip: text;
    -webkit-background-clip: text;
    user-select: none;
    white-space: nowrap;
    text-align: center;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 22px 28px;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
</style>
